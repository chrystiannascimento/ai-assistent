# Copie este arquivo para .env e preencha com valores reais.
# Nunca commite o .env de verdade.

# --- Home Assistant ---
HA_URL=http://localhost:8123
HA_LONG_LIVED_TOKEN=changeme

# --- Ollama (orquestrador local) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- LiteLLM (proxy/roteador) ---
LITELLM_URL=http://localhost:4000
LITELLM_MASTER_KEY=changeme

# --- Modelo escalonado (ex.: Claude via LiteLLM) ---
ANTHROPIC_API_KEY=changeme
ESCALATION_MODEL=claude-sonnet-5

# --- Presidio ---
PRESIDIO_ANALYZER_URL=http://localhost:5001
PRESIDIO_ANONYMIZER_URL=http://localhost:5002

# --- Wyoming (voz) ---
WYOMING_WAKEWORD_HOST=localhost
WYOMING_WAKEWORD_PORT=10400
WYOMING_WHISPER_HOST=localhost
WYOMING_WHISPER_PORT=10300
WYOMING_PIPER_HOST=localhost
WYOMING_PIPER_PORT=10200

# --- Pseudonimizacao ---
# TTL (segundos) do mapa de reversao nome-real <-> placeholder
PSEUDONIMIZACAO_TTL_SEGUNDOS=300
